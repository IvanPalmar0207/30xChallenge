# =============================================================================
# PayBlood environment template (safe placeholders only — never real secrets)
# =============================================================================
# Copy this file to `.env` at the repository root and replace the placeholders
# with real values for your machine. The real `.env` file is gitignored and
# must never be committed. The AI_API_KEY is read by the backend at runtime
# only; it is never committed and never placed in frontend code (frontend
# values are public by design).
#
# Generate a real Django secret key with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"

# --- Django core -------------------------------------------------------------
DJANGO_SECRET_KEY=change-me-generate-a-real-secret-token-urlsafe-64-chars-0123456789abcdef0123456789abcdef0123456789abcdef
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database -----------------------------------------------------------------
# SQLite is the default local database. PostgreSQL stays possible by switching
# to a postgres:// URL; the credentials live only in `.env`, never in code.
DATABASE_URL=sqlite:///db.sqlite3
# DATABASE_URL=postgres://payblood:change-me@localhost:5432/payblood

# --- CORS ----------------------------------------------------------------------
# Browser origins allowed to call the API (the Angular dev server by default).
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:4200

# --- AI extraction (reserved for a later phase; not used yet) ------------------
# Invariant: the AI extracts invoice data; it never approves invoices and it
# never makes financial decisions.
AI_PROVIDER=
AI_MODEL=
AI_API_KEY=
